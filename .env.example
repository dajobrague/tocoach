RESEND_API_KEY=
RESEND_FROM_EMAIL=TopCoach <noreply@topcoach.app>
# Server-only: every server-side query uses this key (lib/clients/supabase-admin.ts); anon has no table grants. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=
# Server-only, REQUIRED: the Supabase project JWT secret (Supabase → Settings → API → JWT Secret).
# NOT the same value as JWT_SECRET (the app's own session secret) — there is no fallback.
# Signs the Realtime token minted by GET /api/realtime/token; without it Realtime is disabled (500 + server log).
SUPABASE_JWT_SECRET=
# Server-only: shared secret for GET /api/cron/cleanup-otps (Bearer, x-cron-secret, or ?secret=)
CRON_SECRET=
